{
  "name": "@zhuweiyou/dsh-holdem",
  "version": "0.1.5",
  "description": "德州扑克：6 人桌、超员自动观战、多局排行榜；牌桌可跑在本机或 Cloudflare Worker 上。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "texas-holdem",
    "poker",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "author": "zhuweiyou",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "worker",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "wrangler.toml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && node scripts/emit-dts.mjs && tsdown --config tsdown.config.ts && tsdown --config tsdown.client.ts && tsdown --config tsdown.worker.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm build && pnpm test",
    "prepublishOnly": "pnpm verify",
    "worker:dev": "pnpm worker:build && wrangler dev --port 8787",
    "worker:deploy": "pnpm worker:build && wrangler deploy",
    "worker:typecheck": "tsc -p worker/tsconfig.json --noEmit",
    "worker:build": "tsdown --config tsdown.worker.ts"
  },
  "dependencies": {
    "wrangler": "^4.152.0",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "@types/ws": "^8.18.1",
    "lightningcss": "^1.30.1",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
